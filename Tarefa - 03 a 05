    "pct_geo = (df_geo / 8) * 100\n",
    "pct_ing = (df_ing / 8) * 100\n",
    "pct_his = (df_his / 8) * 100\n",
    "pct_fis = (df_fis / 12) * 100\n",
    "pct_qui = (df_qui / 12) * 100\n",
    "\n",
    "\n"
